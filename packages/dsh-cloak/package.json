{
  "name": "dsh-cloak",
  "version": "0.2.0",
  "description": "Context firewall for DeepSeek Harness: credentials in tool results become opaque placeholders before they reach the model. Part of the cloakpack monorepo (shared engine with the cloakpack CLI).",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "security",
    "redaction",
    "secrets",
    "dlp",
    "context-firewall"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangmiao03/cloakpack.git",
    "directory": "packages/dsh-cloak"
  },
  "homepage": "https://github.com/zhangmiao03/cloakpack/tree/main/packages/dsh-cloak#readme",
  "bugs": {
    "url": "https://github.com/zhangmiao03/cloakpack/issues"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-host-webserver": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-session": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cloakpack/core": "*"
  }
}